<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>AI Assistant</title>
    <style>
        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            background: #101116;
            color: #f3f3f5;
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        main {
            width: min(92vw, 560px);
            padding: 32px;
            border: 1px solid #2a2c34;
            border-radius: 12px;
            background: #18191f;
            text-align: center;
        }

        h1 {
            margin: 0 0 10px;
            font-size: 24px;
            letter-spacing: 0;
        }

        p {
            margin: 0 0 24px;
            color: #8f9098;
        }

        a {
            color: #a78bfa;
            text-decoration: none;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <main>
        <h1>Welcome, <%= user.username %></h1>
        <p>You are logged in. Your frontend/chat application can start from here.</p>
        <a href="/logout">Logout</a>
    </main>
</body>
</html>
